@page "/"

<div class="question-shell">
    <span class="netbot-rocket question-netbot" aria-hidden="true"></span>
    <span class="netbot-rocket is-cruise question-netbot" aria-hidden="true"></span>
    <span class="netbot-rocket is-launch question-netbot" aria-hidden="true"></span>
    <header class="question-header">
        <a class="question-brand" href="/"><span class="question-mark">E</span><span><strong>@EventName</strong><small>COMMUNITY QUESTIONS</small></span></a>
        <span class="theme-control">
            <button class="theme-toggle" type="button" @onclick="ToggleTheme" disabled="@(browser is null)" aria-label="Light theme"
                    aria-pressed="@lightTheme.ToString().ToLowerInvariant()" title="Switch to @(lightTheme ? "dark" : "light") theme">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    @if (lightTheme)
                    {
                        <path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" />
                    }
                    else
                    {
                        <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
                    }
                </svg>
                <span>@(lightTheme ? "Dark" : "Light")</span>
            </button>
            @if (!string.IsNullOrEmpty(themeError))
            {
                <span class="theme-error" role="status">@themeError</span>
            }
        </span>
    </header>
    <main class="question-page">
        <section class="question-introduction" aria-labelledby="question-title">
            <p class="question-eyebrow">A LITTLE CURIOSITY. A GREAT CONVERSATION.</p>
            <h1 id="question-title">Your question.<br /><em>Our next conversation.</em></h1>
            <p>Ask the @EventName team about the things that spark your curiosity.</p>
            <div class="question-process"><span>01 &nbsp; You ask</span><span>02 &nbsp; We review</span><span>03 &nbsp; The hosts discuss</span></div>
            @if (config?.DemoMode == true)
            {
                <p class="question-demo">Demo mode - simulated event</p>
            }
        </section>
        <section class="question-card" aria-label="Submit a question">
            @if (loading)
            {
                <p role="status">Getting ready for your question...</p>
            }
            else if (config is null)
            {
                <div role="alert">@message</div>
                <button class="question-send" type="button" @onclick="Reload">Try loading again</button>
            }
            else if (received)
            {
                <div class="question-success" role="status">
                    <span aria-hidden="true">+</span><h2>Safely in the queue.</h2>
                    <p>Thank you for asking. Every question is reviewed before it can appear on the live wall. Sending does not guarantee publication.</p>
                    <button class="question-send" type="button" @onclick="AskAnother">Ask another question</button>
                </div>
            }
            else
            {
                <form @onsubmit="Submit" @onsubmit:preventDefault aria-busy="@sending.ToString().ToLowerInvariant()">
                    <h2>What would you like to ask?</h2>
                    <p class="question-subtitle">Keep it kind, keep it curious. Every question is reviewed.</p>
                    <label for="question-text">Your question</label>
                    <textarea id="question-text" required maxlength="2000" @bind="text" @bind:event="oninput" rows="6"
                              placeholder="I'd love to know more about..." aria-describedby="question-count"></textarea>
                    <div id="question-count" class="question-count"><span>A good conversation starts here.</span><span>@text.Length/2000</span></div>
                    <label for="question-name">Name <span>(optional)</span></label>
                    <input id="question-name" maxlength="80" @bind="displayName" @bind:event="oninput" autocomplete="nickname" placeholder="How should we credit you?" />
                    <label class="question-honeypot" aria-hidden="true">Leave blank<input id="question-website" tabindex="-1" autocomplete="off" @bind="website" @bind:event="oninput" /></label>
                    <p class="question-privacy">The team may show or read your question and name publicly. Sending does not guarantee publication. Please don't include private information.@(ChallengeEnabled ? " Cloudflare Turnstile checks this form for automated abuse." : "")</p>
                    @if (ChallengeEnabled)
                    {
                        <div id="question-challenge" class="question-challenge"></div>
                    }
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="question-error" role="alert">@message</div>
                    }
                    <button class="question-send" type="submit" disabled="@(sending || string.IsNullOrWhiteSpace(text) || coolingDown)">
                        @(sending ? "Sending..." : renewToken ? "Refresh and retry" : coolingDown ? "Please wait before retrying" : "Send to the team")
                        <span aria-hidden="true">&rarr;</span>
                    </button>
                    <p class="question-safety">Thoughtful questions. Human moderation. A better conversation.</p>
                </form>
            }
        </section>
    </main>
    <QuestionFooter />
</div>
